# Copy this file to .env and fill in the values. .env is git-ignored.
# Real environment variables take priority over this file.

# local or staging (default: staging, the deployed site)
TEST_ENV=staging

# Optional overrides. When empty, the TEST_ENV defaults are used:
#   staging: https://quality-lab-jb.vercel.app
#   local:   http://localhost:3100
BASE_URL=
# Defaults to <BASE_URL>/api/v1
API_BASE_URL=

# Required: the seeded banking customer (the tests use this customer's checking and savings accounts)
TEST_USERNAME=
TEST_PASSWORD=

# Optional run settings
# WORKERS=4
# RETRIES=1

# Open the summary report (reports/summary/test-report.html) in Chrome after each run:
# always (default), on-failure, or never. It never opens on CI.
# OPEN_REPORT=always
# Only if Chrome is installed somewhere unusual:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: keep Playwright's browsers inside this project (node_modules/playwright-core/.local-browsers)
# instead of %LOCALAPPDATA%\ms-playwright. Needed on PCs where Firefox fails to start from the default
# folder with "side-by-side configuration is incorrect". Install the browsers with the same setting.
# PLAYWRIGHT_BROWSERS_PATH=0
